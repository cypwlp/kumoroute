{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KumoRoute",
  "version": "0.4.0",
  "identifier": "io.github.cypwlp.kumoroute",
  "build": {
    "frontendDist": "../client/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KumoRoute",
        "width": 1120,
        "height": 720,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "backgroundColor": "#0b0e14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
