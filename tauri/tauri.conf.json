{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyClash",
  "version": "0.1.0",
  "identifier": "com.myclash.desktop",
  "build": {
    "frontendDist": "../client/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MyClash",
        "width": 1120,
        "height": 720,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "backgroundColor": "#0b0e14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../client/core/mihomo.exe": "core/mihomo.exe",
      "../client/core/geoip.metadb": "core/geoip.metadb",
      "../client/core/geosite.dat": "core/geosite.dat",
      "../client/core/LICENSE-GPL3.txt": "core/LICENSE-GPL3.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
